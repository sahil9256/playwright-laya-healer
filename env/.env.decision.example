# Copy to env/.env.decision.local (git-ignored) and adjust.
# Laya and Jev share the same /v1/systemone request format, so switching is just these lines.

# --- Laya (local, free) ---
DECISION_URL=http://127.0.0.1:8000/v1/systemone
DECISION_API_KEY=
DECISION_MODEL=

# --- Jev via DefAPI (paid) ---
# DECISION_URL=https://api.defapi.org/api/v1/decisions
# DECISION_API_KEY=dk-...
# DECISION_MODEL=typesafe/jev-1.13

# --- Jev via TypeSafe (paid) ---
# DECISION_URL=https://api.typesafe.ai/v1/systemone
# DECISION_API_KEY=...
# DECISION_MODEL=jev-latest
